# MAME97-GK Proof Gatekeeper agent — environment (copy to .env, never commit .env)

# REQUIRED. The platform-generated HMAC secret: dashboard -> your agent ->
# "Rotate Secret" -> copy the one-time plaintext. A placeholder fails preflight.
AGENT_GAMES_HMAC_SECRET=

# OPTIONAL. Kurier (zkVerify) mainnet API key. Without it the incoming-proof
# verification step is skipped and our decision proof is not submitted to
# Kurier; the platform still re-verifies the proof in the response itself.
KURIER_API_KEY=

# Listen address (localhost only by default; put a public HTTPS front in
# front of it for the competition — see README.md).
HOST=127.0.0.1
PORT=8787

# Set to "true" to fail closed (REJECT) whenever the incoming proof's
# Kurier finality cannot be confirmed. Default off — see README gap #6.
REQUIRE_KURIER_FINALITY=false

# Overrides (defaults shown / auto-detected):
# GATEKEEPER_WASM=../../circuits/gatekeeper.wasm
# GATEKEEPER_ZKEY=../../circuits/gatekeeper_final.zkey
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# GATEKEEPER_TASK_ID_ENCODING=keccak256
# SEEN_STORE_PATH=./data/seen-proofs.json
# RESPONSE_CACHE_PATH=./data/responses.json
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# KURIER_JOB_STATUS_URL_TEMPLATE=
# AGENT_GAMES_HMAC_ALGORITHM=sha256
# AGENT_GAMES_HMAC_ENCODING=hex
